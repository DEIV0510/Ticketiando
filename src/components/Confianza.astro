---
import Icono from './Icono.astro';
import { CONTACTO } from '../data/sitio';

const pilares = [
  { icono: 'escudo' as const, titulo: 'Boletería oficial', texto: 'PULEP en cada evento' },
  { icono: 'tarjeta' as const, titulo: 'Pago seguro', texto: 'PSE, Visa y Mastercard' },
  { icono: 'whatsapp' as const, titulo: 'Soporte por WhatsApp', texto: CONTACTO.whatsapp.texto },
  { icono: 'identificacion' as const, titulo: 'Retracto de 5 días', texto: 'En compras en línea' },
];
---

<section class="confianza" data-superficie="blanco" aria-label="Por qué comprar en Ticketiando">
  <ul class="contenedor confianza__lista">
    {
      pilares.map((p) => (
        <li>
          <Icono nombre={p.icono} />
          <p>
            <strong>{p.titulo}</strong>
            <span>{p.texto}</span>
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .confianza {
    border-bottom: 1px solid var(--linea);
  }
  .confianza__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 16px;
    list-style: none;
    margin: 0 auto;
    padding-block: 22px;
  }
  @media (min-width: 900px) {
    .confianza__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  li {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  li :global(svg) {
    width: 26px;
    height: 26px;
    flex: none;
    color: var(--naranja-oscuro);
  }
  p {
    display: grid;
    line-height: 1.25;
  }
  strong {
    font-weight: 800;
    font-size: 0.9375rem;
  }
  span {
    font-size: 0.8125rem;
    color: var(--texto-2);
  }
</style>
