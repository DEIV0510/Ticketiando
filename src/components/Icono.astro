const esMarca = nombre === 'whatsapp' || nombre === 'instagram';
---

{
  esMarca ? (
    <svg class={clase} viewBox="0 0 24 24" fill="currentColor" aria-hidden={titulo ? undefined : 'true'} role={titulo ? 'img' : undefined} aria-label={titulo}>
