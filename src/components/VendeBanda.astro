---
import Icono from './Icono.astro';

// Organizadores que figuran como responsables en eventos publicados en ticketiando.com
const ORGANIZADORES = ['Live Concerts Latam', 'LPC Producciones', 'Alpha Musik Colombia'];
---

<section class="vende" aria-labelledby="vende-titulo">
  <div class="contenedor vende__in">
    <div class="vende__texto">
      <h2 id="vende-titulo" class="titulo-seccion">¿Organizas un evento?</h2>
      <p class="entrada">Vende tu boletería con Ticketiando: en línea y en puntos físicos, en todo el país.</p>
      <div class="vende__ctas">
        <a class="btn btn--noche btn--grande" href="/vende-tu-evento/">Vende tu evento <Icono nombre="flecha" /></a>
      </div>
    </div>
    <div class="vende__aliados">
      <p>Han vendido con nosotros</p>
      <ul>
        {ORGANIZADORES.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .vende {
    --texto: var(--noche);
    --texto-2: rgb(0 10 50 / 0.82);
    --acento-texto: var(--noche);
    --linea: rgb(0 10 50 / 0.2);
    background: var(--naranja);
    color: var(--noche);
    padding-block: clamp(40px, 5vw, 64px);
    position: relative;
    overflow: hidden;
  }
  .vende::after {
    /* muescas de boleta en los bordes de la banda */
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle 18px at 0 50%, var(--papel) 98%, transparent) left center / 36px 36px no-repeat,
      radial-gradient(circle 18px at 100% 50%, var(--papel) 98%, transparent) right center / 36px 36px no-repeat;
  }
  .vende__in {
    display: grid;
    gap: 40px;
    position: relative;
    z-index: 1;
  }
  @media (min-width: 1080px) {
    .vende__in {
      grid-template-columns: 1.4fr 0.8fr;
      align-items: end;
      gap: 72px;
    }
  }
  .vende__texto {
    display: grid;
    gap: 18px;
  }
  .vende__ctas {
    margin-top: 8px;
  }
  .vende .btn--noche:focus-visible {
    outline-color: var(--noche);
  }
  .vende__aliados {
    border-top: 3px solid var(--noche);
    padding-top: 18px;
  }
  .vende__aliados p {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .vende__aliados ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .vende__aliados li {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 900;
    font-stretch: var(--muy-estrecha);
    font-family: var(--fuente-68);
    text-transform: uppercase;
    line-height: 1.1;
    padding: 8px 0;
    border-bottom: 1px solid var(--linea);
  }
</style>
