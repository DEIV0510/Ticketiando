---
import Base from '../layouts/Base.astro';
import Heroe from '../components/Heroe.astro';
import Confianza from '../components/Confianza.astro';
import TarjetaEvento from '../components/TarjetaEvento.astro';
import CompraSeguraCorta from '../components/CompraSeguraCorta.astro';
import Realizados from '../components/Realizados.astro';
import VendeBanda from '../components/VendeBanda.astro';
import Icono from '../components/Icono.astro';
import { EVENTOS } from '../data/eventos';
import { CONTACTO } from '../data/sitio';
import { esProximo, ordenarPorFecha } from '../lib/formato';
import { getImage } from 'astro:assets';

const proximos = ordenarPorFecha(EVENTOS.filter((e) => esProximo(e)));
const og = proximos[0] ? await getImage({ src: proximos[0].imagenes.banner, width: 1200, format: 'jpg', quality: 80 }) : null;
---

<Base
  titulo="Ticketiando · Boletería oficial para conciertos, festivales y eventos"
  descripcion="Compra boletas oficiales para conciertos, festivales, fiestas y shows familiares en Colombia. Pago seguro con PSE y tarjeta."
  imagen={og?.src}
>
  {proximos.length > 0 ? <Heroe eventos={proximos} /> : null}

  <section class="proximos" data-superficie="papel" aria-labelledby="proximos-titulo">
    <div class="contenedor">
      <div class="proximos__cab">
        <h2 id="proximos-titulo" class="titulo-seccion">Eventos en venta</h2>
        <a class="enlace-flecha" href="/eventos/">Ver todos <Icono nombre="flecha" /></a>
      </div>

      <div class="proximos__lista" data-lista-proximos="#proximos-vacio">
        {proximos.map((e) => <TarjetaEvento evento={e} />)}
      </div>

      <div id="proximos-vacio" class="vacio" hidden={proximos.length > 0}>
        <Icono nombre="calendario" />
        <p>
          <strong>Muy pronto, nuevos eventos.</strong>
          Síguenos en <a href={CONTACTO.instagram.href} target="_blank" rel="noopener">Instagram {CONTACTO.instagram.texto}</a>.
        </p>
      </div>
    </div>
  </section>

  <Confianza />
  <CompraSeguraCorta />
  <Realizados />
  <VendeBanda />
</Base>

<style>
  .proximos {
    padding-block: clamp(36px, 5vw, 64px);
  }
  .proximos__cab {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .proximos__cab .enlace-flecha {
    white-space: nowrap;
  }
  .proximos__lista {
    display: grid;
    gap: 22px;
  }
  .vacio {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 24px;
    background: var(--blanco);
    border: 1px dashed var(--linea-fuerte);
  }
  .vacio :global(svg) {
    width: 28px;
    height: 28px;
    color: var(--naranja-oscuro);
    flex: none;
  }
  .vacio a {
    color: var(--acento-texto);
    font-weight: 700;
  }
</style>
