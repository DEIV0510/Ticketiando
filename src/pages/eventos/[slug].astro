<script>
  document.querySelectorAll<HTMLButtonElement>('[data-compartir]').forEach((b) => {
    b.addEventListener('click', async () => {
      const { titulo = '', texto = '', url = location.href } = b.dataset;
      const txt = b.querySelector<HTMLElement>('[data-compartir-txt]');
      if (navigator.share) {
        try {
          await navigator.share({ title: titulo, text: texto, url });
        } catch {
          /* el usuario canceló */
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(`${texto} ${url}`);
        if (txt) txt.textContent = '¡Enlace copiado!';
      } catch {
        window.open(`https://wa.me/?text=${encodeURIComponent(`${texto} ${url}`)}`, '_blank', 'noopener');
      }
      setTimeout(() => txt && (txt.textContent = 'Compartir'), 2500);
    });
  });
</script>
