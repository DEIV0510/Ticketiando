---
// Páginas legales con el texto vigente de ticketiando.com (importado con scripts/legal.mjs). Mismas URL que hoy.
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { LEGAL, CONTACTO } from '../data/sitio';

const archivos = import.meta.glob<string>('../content/legal/*.html', { query: '?raw', import: 'default', eager: true });

const PAGINAS: Record<string, { titulo: string; descripcion: string }> = {
  'politicas-y-condiciones': { titulo: 'Términos y condiciones', descripcion: 'Términos y condiciones de uso de la plataforma digital Ticketiando y de la compra de boletería.' },
  'manual-de-tratamiento-de-datos': { titulo: 'Tratamiento de datos personales', descripcion: 'Manual de políticas y procedimientos para el tratamiento de datos personales de Ticketiando.' },
  devoluciones: { titulo: 'Devoluciones y derecho de retracto', descripcion: 'Cómo funcionan las devoluciones por cancelación de eventos y el derecho de retracto en Ticketiando.' },
  'cambios-por-perdida-o-danos': { titulo: 'Cambios por pérdida o daño', descripcion: 'Política de cambio de boletas por daño, deterioro o extravío en Ticketiando.' },
};

export function getStaticPaths() {
  return ['politicas-y-condiciones', 'manual-de-tratamiento-de-datos', 'devoluciones', 'cambios-por-perdida-o-danos'].map((legal) => ({ params: { legal } }));
}

const { legal } = Astro.params as { legal: string };
const pagina = PAGINAS[legal];
const html = archivos[`../content/legal/${legal}.html`];
const actual = `/${legal}/`;
---

<Base titulo={pagina.titulo} descripcion={pagina.descripcion}>
  <section class="cab" data-superficie="noche">
    <div class="contenedor">
      <p class="antetitulo">Legal</p>
      <h1 class="titulo-seccion cab__titulo">{pagina.titulo}</h1>
    </div>
  </section>
  <section class="seccion" data-superficie="blanco">
    <div class="contenedor rejilla">
      <nav class="indice" aria-label="Documentos legales">
        <ul>
          {
            LEGAL.map((l) => (
              <li>
                <a href={l.href} aria-current={l.href === actual ? 'page' : undefined} {...(l.externo ? { target: '_blank', rel: 'noopener' } : {})}>
                  {l.texto}
                </a>
              </li>
            ))
          }
        </ul>
        <p>¿Dudas? <a href={CONTACTO.whatsapp.href} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> {CONTACTO.whatsapp.texto}</a></p>
      </nav>
      <article class="prosa" set:html={html} />
    </div>
  </section>
</Base>

<style>
  .cab {
    padding: clamp(40px, 6vw, 80px) 0 clamp(28px, 4vw, 48px);
  }
  .cab__titulo {
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    margin-top: 12px;
    max-width: 18ch;
  }
  .rejilla {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1080px) {
    .rejilla {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 64px;
      align-items: start;
    }
    .indice {
      position: sticky;
      top: calc(var(--alto-header) + 32px);
    }
  }
  .indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--linea);
  }
  .indice a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--linea);
    text-decoration: none;
    font-weight: 600;
    color: var(--texto-2);
  }
  .indice a:hover,
  .indice a[aria-current='page'] {
    color: var(--texto);
  }
  .indice a[aria-current='page'] {
    font-weight: 800;
    box-shadow: inset 3px 0 0 var(--naranja);
    padding-left: 12px;
  }
  .indice p {
    margin-top: 18px;
    font-size: 0.875rem;
  }
  .indice p a {
    display: inline-flex;
    gap: 6px;
    min-height: 0;
    border: 0;
    color: var(--acento-texto);
    font-weight: 700;
  }
  .indice p :global(svg) {
    width: 16px;
    height: 16px;
  }
  .prosa :global(h4) {
    font-size: 1.125rem;
  }
</style>
